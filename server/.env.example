# --- Required ---
# Local:   mongodb://127.0.0.1:27017/gridrush
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gridrush?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gridrush

# Browser origins allowed to call the API (comma-separated, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# --- Optional ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Number of reverse proxies in front of the API. Use 1 on Render so rate limits see real client IPs.
TRUST_PROXY=0

# Rate limits (defaults shown)
CLAIM_RATE_LIMIT=20
CLAIM_RATE_WINDOW_MS=5000
SESSION_RATE_LIMIT=10
SESSION_RATE_WINDOW_MS=600000
API_RATE_LIMIT=300
API_RATE_WINDOW_MS=60000
RATE_LIMIT_DISABLED=false
